{
    "enabled": true,
    "rules": {
        "data_quality_score": {
            "enabled": true,
            "warning_below": 95,
            "critical_below": 85
        },
        "execution_duration_seconds": {
            "enabled": true,
            "warning_above": 30,
            "critical_above": 60
        },
        "records_extracted": {
            "enabled": true,
            "warning_below": 3,
            "critical_below": 1
        },
        "rejection_rate_percent": {
            "enabled": true,
            "warning_above": 5,
            "critical_above": 10
        },
        "insertion_efficiency_percent": {
            "enabled": true,
            "warning_below": 90,
            "critical_below": 75
        }
    }
}